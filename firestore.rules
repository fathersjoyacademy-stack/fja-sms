rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public Admissions Intake submissions
    match /users/{userId} {
      allow create: if request.resource.data.status == 'PENDING';
      allow read, write: if isAuthenticated();
    }
    match /profiles/{profileId} {
      allow create: if true;
      allow read, write: if isAuthenticated();
    }
    match /notifications/{notifId} {
      allow create: if true;
      allow read, write: if isAuthenticated();
    }

    // Public CMS Content and Academic Calendar can be read publicly by visitors
    match /cms_content/{contentKey} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /academic_calendar/{calId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // All operational and financial records require authenticated access
    match /classes/{classId} {
      allow read, write: if isAuthenticated();
    }
    match /enrolments/{enrolmentId} {
      allow read, write: if isAuthenticated();
    }
    match /class_posts/{postId} {
      allow read, write: if isAuthenticated();
    }
    match /financial_transactions/{txId} {
      allow read, write: if isAuthenticated();
    }
    match /audit_logs/{auditId} {
      allow read, write: if isAuthenticated();
    }
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }
    match /assignments/{assignId} {
      allow read, write: if isAuthenticated();
    }
    match /student_scores/{scoreId} {
      allow read, write: if isAuthenticated();
    }
    match /lesson_notes/{noteId} {
      allow read, write: if isAuthenticated();
    }
    match /pickup_guardians/{guardianId} {
      allow read, write: if isAuthenticated();
    }
    match /staff_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
    match /sectional_reports/{reportId} {
      allow read, write: if isAuthenticated();
    }
    match /questionnaires/{qId} {
      allow read, write: if isAuthenticated();
    }
    match /questionnaire_responses/{respId} {
      allow read, write: if isAuthenticated();
    }
    match /bank_reconciliations/{reconId} {
      allow read, write: if isAuthenticated();
    }
    match /prospectuses/{prospectusId} {
      allow read, write: if isAuthenticated();
    }
    match /broadcast_requests/{reqId} {
      allow read, write: if isAuthenticated();
    }
    match /broadcast_archives/{archId} {
      allow read, write: if isAuthenticated();
    }
    match /custom_recipient_groups/{groupId} {
      allow read, write: if isAuthenticated();
    }
    match /data_change_requests/{reqId} {
      allow read, write: if isAuthenticated();
    }
    match /elibrary_books/{bookId} {
      allow read, write: if isAuthenticated();
    }
    match /parent_profiles/{parentId} {
      allow read, write: if isAuthenticated();
    }
    match /parent_student_relations/{relationId} {
      allow read, write: if isAuthenticated();
    }
    match /notification_user_reads/{readId} {
      allow read, write: if isAuthenticated();
    }
    match /portal_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
    match /subjects/{subjectId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
